<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="375.0" y="225.0">complaints</tspan></text>
<rect class="lblbg" x="113.19999999999999" y="292.5" width="73.60000000000001" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="150.0" y="305.0">assigns</tspan></text>
<rect class="lblbg" x="307.4" y="372.5" width="135.20000000000002" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="375.0" y="385.0">bans film bags</tspan></text>
<rect class="lblbg" x="347.0" y="292.5" width="56.0" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="375.0" y="305.0">fines</tspan></text>
<rect class="lblbg" x="342.6" y="532.5" width="64.80000000000001" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="375.0" y="545.0">5¢ fee</tspan></text>
<rect class="lblbg" x="329.4" y="622.5" width="91.2" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="375.0" y="635.0">free bags</tspan></text>
<rect class="lblbg" x="550.0" y="452.5" width="100.0" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="600.0" y="465.0">cost / fee</tspan></text>
<rect class="lblbg" x="532.4" y="612.5" width="135.20000000000002" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="600.0" y="625.0">choices add up</tspan></text>
<rect class="lblbg" x="783.8" y="372.5" width="82.4" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="825.0" y="385.0">pressure</tspan></text>
<rect class="lblbg" x="779.4" y="532.5" width="91.2" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="825.0" y="545.0">peer norm</tspan></text>
<rect class="lblbg" x="753.0" y="292.5" width="144.0" height="25" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="825.0" y="305.0">cost complaints</tspan></text>
<rect class="lblbg" x="772.0" y="443.0" width="100.0" height="44" rx="5"/>
<text class="el" text-anchor="middle" dominant-baseline="middle" font-size="15"><tspan x="822.0" y="455.5">feedback:</tspan><tspan x="822.0" y="474.5">complaints</tspan></text>
</svg>
